{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pselamy/operating-agent-fleets/schemas/distribution-package.schema.json",
  "title": "Pre-H4 distribution draft",
  "description": "A draft record only. This schema cannot represent approval, authorization, publication, or live verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "chapter", "channel", "canonical_url", "source_revision", "source_path", "content_path", "visual_path", "alt_text", "evidence_cutoff", "content_sha256"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "chapter": {"type": "integer", "minimum": 1, "maximum": 8},
    "channel": {"enum": ["linkedin_newsletter", "linkedin_post", "medium"]},
    "canonical_url": {"type": "string", "pattern": "^https://selamy\\.dev/agent-fleets/[0-9]{2}-[a-z0-9-]+/$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_path": {"type": "string", "pattern": "^guide/[0-9]{2}-[a-z0-9-]+\\.md$"},
    "content_path": {"type": "string", "pattern": "^distribution/packages/[a-z0-9-]+\\.md$"},
    "visual_path": {"type": ["string", "null"]},
    "alt_text": {"type": ["string", "null"]},
    "evidence_cutoff": {"type": "string", "format": "date"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
