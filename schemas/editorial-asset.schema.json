{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pselamy/operating-agent-fleets/schemas/editorial-asset.schema.json",
  "title": "Operating Agent Fleets editorial asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "role", "path", "media_type", "sha256", "width", "height", "alt_text", "created_at", "provenance_type", "creation_method", "generation_provider", "generation_model", "prompt", "sources", "derivation", "text_policy", "claim_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^editorial\\.[a-z][a-z0-9-]*$"},
    "role": {"enum": ["field_guide_hero", "conceptual_illustration", "social_card_template", "diagram_thumbnail"]},
    "path": {"type": "string", "pattern": "^assets/(generated|templates|thumbnails)/[a-z0-9-]+\\.(png|svg)$"},
    "media_type": {"enum": ["image/png", "image/svg+xml"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "width": {"type": "integer", "minimum": 1, "maximum": 7680},
    "height": {"type": "integer", "minimum": 1, "maximum": 7680},
    "alt_text": {"type": "string", "minLength": 20},
    "created_at": {"type": "string", "format": "date"},
    "provenance_type": {"enum": ["generated", "source_controlled", "derived"]},
    "creation_method": {"type": "string", "minLength": 3},
    "generation_provider": {"type": ["string", "null"]},
    "generation_model": {"type": ["string", "null"]},
    "prompt": {"type": ["string", "null"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^diagrams/[a-z0-9-]+/[a-z0-9.-]+\\.svg$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "derivation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["contract_version", "renderer_path", "renderer_sha256", "parameters"],
          "properties": {
            "contract_version": {"const": 1},
            "renderer_path": {"const": "tools/render_diagram_thumbnail.py"},
            "renderer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "parameters": {
              "type": "object", "additionalProperties": false,
              "required": ["title", "takeaway", "lanes"],
              "properties": {
                "title": {"type": "string", "minLength": 3, "maxLength": 72},
                "takeaway": {"type": "string", "minLength": 12, "maxLength": 82},
                "lanes": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "minLength": 2, "maxLength": 26}}}
              }
            }
          }
        }
      ]
    },
    "text_policy": {"enum": ["no_text_in_generated_pixels", "source_controlled_overlay", "not_applicable"]},
    "claim_status": {"const": "conceptual_not_evidence"}
  },
  "allOf": [
    {
      "if": {"properties": {"provenance_type": {"const": "generated"}}},
      "then": {
        "properties": {
          "generation_provider": {"type": "string", "minLength": 2},
          "generation_model": {"type": "string", "minLength": 3},
          "prompt": {"type": "string", "minLength": 1},
          "sources": {"maxItems": 0},
          "derivation": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"provenance_type": {"const": "source_controlled"}}},
      "then": {
        "properties": {
          "generation_provider": {"type": "null"},
          "generation_model": {"type": "null"},
          "prompt": {"type": "null"},
          "sources": {"maxItems": 0},
          "derivation": {"type": "null"},
          "text_policy": {"const": "source_controlled_overlay"}
        }
      }
    },
    {
      "if": {"properties": {"provenance_type": {"const": "derived"}}},
      "then": {
        "properties": {
          "generation_provider": {"type": "null"},
          "generation_model": {"type": "null"},
          "prompt": {"type": "null"},
          "sources": {"minItems": 1},
          "derivation": {"type": "object"},
          "text_policy": {"const": "source_controlled_overlay"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "field_guide_hero"}}},
      "then": {"properties": {"path": {"pattern": "^assets/generated/[a-z0-9-]+\\.png$"}, "media_type": {"const": "image/png"}, "width": {"const": 1536}, "height": {"const": 1024}, "provenance_type": {"const": "generated"}}}
    },
    {
      "if": {"properties": {"role": {"const": "social_card_template"}}},
      "then": {"properties": {"path": {"pattern": "^assets/templates/[a-z0-9-]+\\.svg$"}, "media_type": {"const": "image/svg+xml"}, "width": {"const": 1200}, "height": {"const": 627}, "provenance_type": {"const": "source_controlled"}}}
    },
    {
      "if": {"properties": {"role": {"const": "diagram_thumbnail"}}},
      "then": {"properties": {"path": {"pattern": "^assets/thumbnails/[a-z0-9-]+\\.png$"}, "media_type": {"const": "image/png"}, "width": {"const": 1200}, "height": {"const": 627}, "provenance_type": {"const": "derived"}}}
    }
  ]
}
