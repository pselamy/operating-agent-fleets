{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pselamy/operating-agent-fleets/schemas/public-evidence.schema.json",
  "title": "Operating Agent Fleets public evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "evidence_class",
    "lineage",
    "verified_at",
    "reverify_after_days",
    "cutoff",
    "public_sources",
    "claims",
    "verification_method",
    "limitations",
    "sensitivity",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "title": {"type": "string", "minLength": 3},
    "evidence_class": {
      "enum": [
        "live_behavior",
        "deployed_artifact",
        "repository_artifact",
        "documentation",
        "internally_corroborated"
      ]
    },
    "lineage": {"enum": ["primary", "copied", "synthetic", "derived"]},
    "verified_at": {"type": "string", "format": "date"},
    "reverify_after_days": {"type": "integer", "minimum": 1, "maximum": 365},
    "cutoff": {"type": "string", "minLength": 4},
    "public_sources": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 10},
      "uniqueItems": true
    },
    "consumer": {"type": "string", "minLength": 2},
    "outcome": {"type": "string", "minLength": 2},
    "verification_method": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3},
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 5},
      "uniqueItems": true
    },
    "sensitivity": {"enum": ["public", "public_derived"]},
    "status": {"enum": ["verified", "limited", "proposed", "stale", "rejected"]}
  }
}
